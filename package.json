{
  "name": "manga-tracker",
  "version": "1.0.0",
  "description": "Track manga chapters from MangaDex with automatic daily updates",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:migrate:prod": "node dist/scripts/migrate-database.js",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:verify:prod": "node dist/scripts/verify-database.js",
    "db:compare": "tsx scripts/compare-databases.ts"
  },
  "author": "PhilippeHo27",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "axios": "^1.20.0",
    "better-auth": "1.7.1",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
